# ── Backend environment variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rfp_db
DB_USER=postgres
DB_PASSWORD=password
# Set to "require" for hosted providers (Aiven, Render, Supabase, etc.)
DB_SSLMODE=prefer

# Flask server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
